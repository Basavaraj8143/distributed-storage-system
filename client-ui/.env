VITE_API_BASE_URL=http://localhost:8080
VITE_API_UPLOAD_PATH=/upload
VITE_API_DOWNLOAD_PATH=/download
VITE_API_NODE_STATUS_PATH=/nodes/status
VITE_API_SYSTEM_HEALTH_PATH=/system/health
VITE_API_LOGS_PATH=/logs
VITE_API_MASTER_LOGS_PATH=/logs/master
# Must match spring.servlet.multipart.max-file-size on the master (used for the client-side check).
VITE_MAX_UPLOAD_MB=10
VITE_USE_MOCK_API=false
VITE_MOCK_DELAY_MS=250
