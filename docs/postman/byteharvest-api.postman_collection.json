{
  "info": {
    "_postman_id": "c1f95fb2-7f88-4a0b-8bfb-2b9d514d4f47",
    "name": "ByteHarvest API",
    "description": "Postman collection for the ByteHarvest master-service and storage-node endpoints. Use with the `ByteHarvest Local` environment.\n\nBefore sending anything, fill in the environment variables:\n- `username` / `password`: the master login (APP_USERNAME / APP_PASSWORD). Applied to every Master Service request as HTTP Basic auth.\n- `nodeToken`: the shared secret (NODE_TOKEN). Sent as the `X-Node-Token` header on Send Heartbeat and on every Storage Node request.\n\nTypical flow:\n1. Start the master (port 8080) and the storage nodes (5001 to 5005). In Docker Compose the nodes are not published, so the Storage Node folder only works for nodes run locally.\n2. `Upload File`, pick a file for the `file` field. The returned fileId is saved to the `fileId` variable.\n3. `List Files`, `File Details`, `Download File` and `Delete File` use the saved `fileId`.\n4. `Get Node Status` and `Get System Health` show ACTIVE, STALE and FAILED nodes.\n\nA 401 means the credential is missing or wrong. Note that the user login does not work on /heartbeat and the node token does not work on the other master endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{username}}", "type": "string" },
      { "key": "password", "value": "{{password}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Master Service",
      "item": [
        {
          "name": "Upload File",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 && pm.response.text()) {",
                  "  pm.environment.set('fileId', pm.response.text());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [], "description": "Select any file up to 10 MB. Field name must be `file`." }
              ]
            },
            "url": { "raw": "{{masterBaseUrl}}/upload", "host": ["{{masterBaseUrl}}"], "path": ["upload"] },
            "description": "Splits the file into chunks and stores replicas on ACTIVE nodes. Response body is the fileId. Errors: 400 empty or invalid upload, 413 over 10 MB, 503 not enough active nodes."
          },
          "response": []
        },
        {
          "name": "Download File",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{masterBaseUrl}}/download/{{fileId}}", "host": ["{{masterBaseUrl}}"], "path": ["download", "{{fileId}}"] },
            "description": "Reassembles the file, verifying each chunk checksum and falling back to other replicas. Use Send and Download to save it. Errors: 400, 404, 503."
          },
          "response": []
        },
        {
          "name": "List Files",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{masterBaseUrl}}/files", "host": ["{{masterBaseUrl}}"], "path": ["files"] },
            "description": "Returns fileId, filename, chunkCount, minReplicas and targetReplicas for every file."
          },
          "response": []
        },
        {
          "name": "File Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{masterBaseUrl}}/files/{{fileId}}", "host": ["{{masterBaseUrl}}"], "path": ["files", "{{fileId}}"] },
            "description": "Returns the file's chunks with chunkId, chunkIndex, checksum and the node URLs holding each replica."
          },
          "response": []
        },
        {
          "name": "Delete File",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{masterBaseUrl}}/files/{{fileId}}", "host": ["{{masterBaseUrl}}"], "path": ["files", "{{fileId}}"] },
            "description": "Deletes the metadata, then removes chunks from the nodes (best effort). Returns 204."
          },
          "response": []
        },
        {
          "name": "Send Heartbeat",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Node-Token", "value": "{{nodeToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nodeId\": \"{{nodeId}}\",\n  \"nodeUrl\": \"{{nodeBaseUrl}}\"\n}"
            },
            "url": { "raw": "{{masterBaseUrl}}/heartbeat", "host": ["{{masterBaseUrl}}"], "path": ["heartbeat"] },
            "description": "Registers or refreshes a node. Uses the node token, not the user login. 401 without a valid X-Node-Token, 400 if nodeId or nodeUrl is blank."
          },
          "response": []
        },
        {
          "name": "Get Node Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{masterBaseUrl}}/nodes/status", "host": ["{{masterBaseUrl}}"], "path": ["nodes", "status"] },
            "description": "Known nodes with nodeId, nodeUrl, lastHeartbeat (epoch ms) and status: ACTIVE, STALE, FAILED or UNKNOWN."
          },
          "response": []
        },
        {
          "name": "Get System Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{masterBaseUrl}}/system/health", "host": ["{{masterBaseUrl}}"], "path": ["system", "health"] },
            "description": "Overall status (HEALTHY, DEGRADED, UNKNOWN), counts and id lists for active, stale and failed nodes, plus the stale and failed timeouts in seconds."
          },
          "response": []
        },
        {
          "name": "Get Event Logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{masterBaseUrl}}/logs?level={{logLevel}}&limit={{logLimit}}",
              "host": ["{{masterBaseUrl}}"],
              "path": ["logs"],
              "query": [
                { "key": "level", "value": "{{logLevel}}", "description": "ALL, INFO, WARN or ERROR." },
                { "key": "limit", "value": "{{logLimit}}" }
              ]
            },
            "description": "Recent in-memory event logs."
          },
          "response": []
        },
        {
          "name": "Get Master Log File Tail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{masterBaseUrl}}/logs/master?lines={{masterLogLines}}",
              "host": ["{{masterBaseUrl}}"],
              "path": ["logs", "master"],
              "query": [{ "key": "lines", "value": "{{masterLogLines}}" }]
            },
            "description": "Tail of logs/master-service.log as text/plain."
          },
          "response": []
        },
        {
          "name": "Simulate Node Offline Through Master",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{masterBaseUrl}}/api/simulation/nodes/{{nodeId}}/offline",
              "host": ["{{masterBaseUrl}}"],
              "path": ["api", "simulation", "nodes", "{{nodeId}}", "offline"]
            },
            "description": "The master calls the node's /simulate/offline. The node must be known from a heartbeat, otherwise 404."
          },
          "response": []
        },
        {
          "name": "Simulate Node Online Through Master",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{masterBaseUrl}}/api/simulation/nodes/{{nodeId}}/online",
              "host": ["{{masterBaseUrl}}"],
              "path": ["api", "simulation", "nodes", "{{nodeId}}", "online"]
            },
            "description": "The master calls the node's /simulate/online."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Storage Node",
      "description": "Internal cluster endpoints. Every request needs the X-Node-Token header (set from the `nodeToken` variable). Set `nodeBaseUrl` to the node you want to reach.",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Store Chunk Directly",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "X-Node-Token", "value": "{{nodeToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "chunkId", "value": "{{chunkId}}", "type": "text" },
                { "key": "file", "type": "file", "src": [], "description": "Chunk bytes. Field name must be `file`." }
              ]
            },
            "url": { "raw": "{{nodeBaseUrl}}/storeChunk", "host": ["{{nodeBaseUrl}}"], "path": ["storeChunk"] },
            "description": "Stores one chunk. The master normally does this during upload. 503 while the node is simulating offline."
          },
          "response": []
        },
        {
          "name": "Get Chunk Directly",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "X-Node-Token", "value": "{{nodeToken}}" }],
            "url": { "raw": "{{nodeBaseUrl}}/getChunk/{{chunkId}}", "host": ["{{nodeBaseUrl}}"], "path": ["getChunk", "{{chunkId}}"] },
            "description": "Reads one chunk. 404 if this node does not hold it."
          },
          "response": []
        },
        {
          "name": "List Chunks",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "X-Node-Token", "value": "{{nodeToken}}" }],
            "url": { "raw": "{{nodeBaseUrl}}/chunks", "host": ["{{nodeBaseUrl}}"], "path": ["chunks"] },
            "description": "Sorted list of chunk ids on this node. The master uses it to reconcile a node that returns after FAILED."
          },
          "response": []
        },
        {
          "name": "Delete Chunk Directly",
          "request": {
            "auth": { "type": "noauth" },
            "method": "DELETE",
            "header": [{ "key": "X-Node-Token", "value": "{{nodeToken}}" }],
            "url": { "raw": "{{nodeBaseUrl}}/deleteChunk/{{chunkId}}", "host": ["{{nodeBaseUrl}}"], "path": ["deleteChunk", "{{chunkId}}"] },
            "description": "Deletes one chunk file. Returns Deleted even if it did not exist."
          },
          "response": []
        },
        {
          "name": "Simulate This Node Offline",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "X-Node-Token", "value": "{{nodeToken}}" }],
            "url": { "raw": "{{nodeBaseUrl}}/simulate/offline", "host": ["{{nodeBaseUrl}}"], "path": ["simulate", "offline"] },
            "description": "Stops heartbeats and makes chunk endpoints return 503. No data is lost."
          },
          "response": []
        },
        {
          "name": "Simulate This Node Online",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "X-Node-Token", "value": "{{nodeToken}}" }],
            "url": { "raw": "{{nodeBaseUrl}}/simulate/online", "host": ["{{nodeBaseUrl}}"], "path": ["simulate", "online"] },
            "description": "Brings the node back online."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    { "key": "masterBaseUrl", "value": "http://localhost:8080" },
    { "key": "nodeBaseUrl", "value": "http://localhost:5001" },
    { "key": "username", "value": "admin" },
    { "key": "password", "value": "" },
    { "key": "nodeToken", "value": "" },
    { "key": "nodeId", "value": "node-1" },
    { "key": "fileId", "value": "" },
    { "key": "chunkId", "value": "sample-chunk" },
    { "key": "logLevel", "value": "ALL" },
    { "key": "logLimit", "value": "100" },
    { "key": "masterLogLines", "value": "500" }
  ]
}
