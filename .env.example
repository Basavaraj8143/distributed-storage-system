# Copy this file to ".env" (same folder) and fill in the values. ".env" is not committed.
# docker compose reads ".env" automatically.

# Login for the UI and API (phase 1).
APP_USERNAME=admin
APP_PASSWORD=

# Secret shared by the master and every storage node (phase 2). At least 16 characters.
# Generate one with:   openssl rand -hex 32
# PowerShell, if you do not have openssl (prints 64 hex characters):
#   $b = New-Object byte[] 32; (New-Object Security.Cryptography.RNGCryptoServiceProvider).GetBytes($b); ($b | % { $_.ToString('x2') }) -join ''
NODE_TOKEN=
